# =============================================================================
# Шаблон переменных окружения для бота Arti.
# Скопируйте в .env и заполните реальными значениями. .env НЕ коммитится.
# =============================================================================

# --- Telegram ---
# Токен бота от @BotFather (обязательно для запуска main.py)
TELEGRAM_TOKEN=
# Telegram Mini App (optional). HTTPS origin must proxy to the local listener.
ARTI_MINIAPP_ENABLED=false
ARTI_MINIAPP_URL=
ARTI_MINIAPP_HOST=127.0.0.1
ARTI_MINIAPP_PORT=8765
# Учётные данные Telegram API для get_my_code.py (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- База данных PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arti_bot
DB_USER=postgres
DB_PASSWORD=

# --- LLM / AI ключи ---
# Все подключения LLM, включая native Gemini, задаются в ai_models.
# Необязательный источник для однократного переноса ключа в БД:
# python -m tools.configure_model_connections --native-gemini
# Во время запросов ключ из окружения не используется; см. docs/ARTI_AI_MODELS.md.
GEMINI_API_KEY=
# Groq (STT)
GROQ_API_KEY=
# Генерация изображений: InferAll (один или несколько ключей через запятую)
INFERALL_API_KEY=
# YepAPI (изображения/видео; один или несколько ключей через запятую)
YEPAPI_API_KEY=
# Прочие медиа-API
AIRFORCE_TOKEN=
FREETHEAI_API_KEY=
# Транскрипция AssemblyAI
ASSEMBLYAI_API_KEY=

# --- Файловый хостинг ---
# Catbox userhash (опционально; пусто = анонимная загрузка)
CATBOX_USERHASH=

# --- Права доступа ---
# ID владельцев бота через запятую (глобальные привилегии)
PRIVILEGED_USER_IDS=

# --- Стикеры ---
STICKERS_ENABLED=True
ARTI_STICKER_SET=arti_stickers

# --- TTS (опционально, значения по умолчанию заданы в коде) ---
# Включает голосовые фичи (озвучка ответов, /vclone, /steal, /dub, /voice_save).
# По умолчанию False. Включать только если подняты TTS-бэкенды ниже.
TTS_ENABLED=False
# VOXCPM_DEMO_SPACE=openbmb/VoxCPM-Demo
# VOXCPM_URL=http://localhost:8000/generate
# VOXCPM_TTS_BACKEND=voxcpm-demo
# VOXCPM_TIMEOUT=120
# VOXCPM_CLONE_MODE=reference

# STT: original audio + bounded rechecks on vocals and independent Qwen3-ASR.
# Russian automatically falls back to Universal-2.
# ASR_SPEECH_MODELS=universal-3-5-pro,universal-2
# ASR_LANGUAGE=en
# ASR_CONTEXT=Dialogue from an animated series.
# ASR_KEYTERMS_FILE=character_names.json
# ASR_ALIGNER=qwen
# ASR_RECHECK=hybrid

# Карточки отчётов: Rich Messages (Bot API 10.3). False для старого local Bot API.
# Обычные HTML-карточки, файлы и кнопки работают при False.
ARTI_TELEGRAM_RICH_MESSAGES=true
